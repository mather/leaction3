{
  "name": "leaction",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "wrangler types --check && tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deploy": "vite build && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview vite build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply leaction --local",
    "db:migrate:remote": "wrangler d1 migrations apply leaction --remote",
    "db:migrate:preview": "wrangler d1 migrations apply leaction-preview --remote --env preview",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "hono": "^4.13.12",
    "solid-js": "^1.9.15",
    "uqr": "^0.1.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.62.3",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
