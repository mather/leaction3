{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leaction",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15", // vitest-pool-workers 同梱の workerd が対応する日付までにする
  "observability": { "enabled": true },
  // 静的アセット（SPA）は @cloudflare/vite-plugin がビルド結果を配信する。
  // /api/* と /e/*（OGP の差し込み）は常に Worker で処理し、それ以外で見つからないパスは index.html を返す。
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/e/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leaction",
      "database_id": "86f57304-2664-4d9f-8091-1748b5119120",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "EVENT_ROOM", "class_name": "EventRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventRoom"] }],
  // アクセス解析（docs/analytics.md）。データセットは最初の書き込みで作られる
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "leaction_analytics" }],
  // PR のプレビュー用環境（Worker 名は leaction-preview）。D1 と DO を本番と分ける。
  // ビルド時に CLOUDFLARE_ENV=preview を渡して選ぶ（pnpm deploy:preview）。
  // d1_databases・durable_objects・analytics_engine_datasets は継承されないので、ここにも書く。
  // シークレットは `wrangler secret put <名前> --env preview` で別に設定する。
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "leaction-preview",
          "database_id": "49845c15-544c-4326-bbf5-eeaf30af5d23",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "EVENT_ROOM", "class_name": "EventRoom" }]
      },
      "analytics_engine_datasets": [
        { "binding": "ANALYTICS", "dataset": "leaction_analytics_preview" }
      ]
    }
  }
}
